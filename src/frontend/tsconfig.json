{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "vite/client",
      "vitest/globals"
    ],
    "baseUrl": ".",
    "paths": {
      "@testing-library/*": [
        "node_modules/@testing-library/*"
      ],
      "vitest": [
        "node_modules/vitest"
      ],
      "react/jsx-runtime": [
        "node_modules/@types/react/jsx-runtime"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "eslint.config.js",
    "../../tests/integration/frontend/**/*.tsx",
    "vitest.integration.config.ts"
  ]
}
