  "paths": {
    "/api/v1/alerts": {
      "get": {
        "description": "Cảnh báo (chỉ đọc); query: building_id, device_id, limit, cursor.",
        "operationId": "alerts_api_v1_alerts_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "NOT_FOUND"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "INVALID_QUERY, FILTER_MISMATCH hoặc INVALID_CURSOR"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "DEPENDENCY_UNAVAILABLE"
          }
        },
        "summary": "Alerts",
        "tags": [
          "alerts"
        ]
      }
    },
