diff --git a/src/backend/app/export_clients.py b/src/backend/app/export_clients.py
new file mode 100644
index 0000000..4242a0d
--- /dev/null
+++ b/src/backend/app/export_clients.py
@@ -0,0 +1,61 @@
+"""Cấp token cho client xuất dữ liệu. Token chỉ hiện một lần; DB chỉ giữ SHA-256.
+
+    cd src/backend && DATABASE_URL=... python -m app.export_clients --id ops --name "Ops script" \
+        --building BLD-A --can-export
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import secrets
+import sys
+
+from sqlalchemy import select
+from sqlalchemy.orm import Session
+
+from .config import Settings
+from .db import make_engine
+from .models import Building, ExportClient, ExportClientScope
+from .params import ID_RE
+
+
+def hash_token(token: str) -> str:
+    return hashlib.sha256(token.encode("utf-8")).hexdigest()
+
+
+def issue_client(db: Session, *, client_id: str, name: str, buildings: list[str], can_export: bool) -> str:
+    if not ID_RE.match(client_id):
+        raise ValueError("client_id sai định dạng")
+    known = set(db.scalars(select(Building.building_id).where(Building.building_id.in_(buildings))))
+    missing = sorted(set(buildings) - known)
+    if missing:
+        raise ValueError(f"building không tồn tại: {', '.join(missing)}")
+    token = secrets.token_urlsafe(32)
+    db.add(ExportClient(client_id=client_id, name=name, token_sha256=hash_token(token), can_export=can_export))
+    db.flush()
+    db.add_all(ExportClientScope(client_id=client_id, building_id=b) for b in sorted(set(buildings)))
+    db.commit()
+    return token
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--id", required=True)
+    ap.add_argument("--name", required=True)
+    ap.add_argument("--building", action="append", required=True)
+    ap.add_argument("--can-export", action="store_true")
+    a = ap.parse_args(argv)
+    settings = Settings.from_env()
+    with Session(make_engine(settings.database_url, settings.statement_timeout_ms)) as db:
+        try:
+            token = issue_client(db, client_id=a.id, name=a.name, buildings=a.building, can_export=a.can_export)
+        except ValueError as exc:
+            print(f"lỗi: {exc}", file=sys.stderr)
+            return 1
+    # In ra stdout đúng một lần để người vận hành lưu; không ghi log.
+    print(token)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/backend/app/exports.py b/src/backend/app/exports.py
new file mode 100644
index 0000000..78ea2ed
--- /dev/null
+++ b/src/backend/app/exports.py
@@ -0,0 +1,209 @@
+"""Xuất dữ liệu readings theo building (BT3 VT-023).
+
+Bất biến cần bảo vệ: mỗi (client_id, Idempotency-Key) ứng với ĐÚNG MỘT export, và export chỉ chứa
+readings của building nằm trong scope của client đó. Guard đồng thời nằm ở PostgreSQL
+(UNIQUE uq_exports_client_key + INSERT ... ON CONFLICT DO NOTHING), không nằm ở bộ nhớ ứng dụng.
+"""
+from __future__ import annotations
+
+import csv
+import hashlib
+import io
+import json
+import uuid
+from collections.abc import Callable
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from decimal import Decimal
+from typing import Protocol
+
+from sqlalchemy import select
+from sqlalchemy.dialects.postgresql import insert as pg_insert
+from sqlalchemy.orm import Session
+
+from .models import Device, Export, Reading
+from .params import UNIT
+
+CSV_COLUMNS = ("message_id", "device_id", "building_id", "metric", "event_time", "received_at",
+               "interval_start", "value", "unit", "is_late", "is_out_of_order")
+_FORMULA_PREFIX = ("=", "+", "-", "@", "\t", "\r")
+
+
+class IdempotencyConflict(Exception):
+    """Cùng Idempotency-Key nhưng nội dung request khác."""
+
+
+class ExportTooLarge(Exception):
+    pass
+
+
+@dataclass(frozen=True)
+class Principal:
+    client_id: str
+    can_export: bool
+    buildings: frozenset[str]
+
+
+@dataclass(frozen=True)
+class ExportRequest:
+    building_id: str
+    metric: str
+    start: datetime
+    end: datetime
+
+    def request_hash(self) -> str:
+        canon = {"building_id": self.building_id, "metric": self.metric,
+                 "start": _iso(self.start), "end": _iso(self.end)}
+        return hashlib.sha256(json.dumps(canon, sort_keys=True).encode()).hexdigest()
+
+
+@dataclass(frozen=True)
+class ExportRow:
+    message_id: str
+    device_id: str
+    building_id: str
+    metric: str
+    event_time: datetime
+    received_at: datetime
+    interval_start: datetime | None
+    value: Decimal
+    unit: str
+    is_late: bool
+    is_out_of_order: bool
+
+
+@dataclass(frozen=True)
+class StoredExport:
+    export_id: uuid.UUID
+    client_id: str
+    idempotency_key: str
+    request_hash: str
+    building_id: str
+    metric: str
+    start: datetime
+    end: datetime
+    row_count: int
+    content_sha256: str
+    content: bytes
+    created_at: datetime
+
+
+class ExportStore(Protocol):
+    def find(self, client_id: str, key: str) -> StoredExport | None: ...
+
+    def insert_if_absent(self, export: StoredExport) -> bool: ...
+
+
+RowSource = Callable[[str, str, datetime, datetime, int], list[ExportRow]]
+
+
+def create_export(store: ExportStore, source: RowSource, principal: Principal, key: str, req: ExportRequest,
+                  *, now: datetime, max_rows: int) -> tuple[StoredExport, bool]:
+    """Trả (export, created). created=False khi là replay của cùng key."""
+    want = req.request_hash()
+    existing = store.find(principal.client_id, key)
+    if existing is not None:
+        return _replay(existing, want), False
+    rows = source(req.building_id, req.metric, req.start, req.end, max_rows + 1)
+    if len(rows) > max_rows:
+        raise ExportTooLarge()
+    content = render_csv(rows)
+    export = StoredExport(
+        export_id=uuid.uuid4(), client_id=principal.client_id, idempotency_key=key, request_hash=want,
+        building_id=req.building_id, metric=req.metric, start=req.start, end=req.end, row_count=len(rows),
+        content_sha256=hashlib.sha256(content).hexdigest(), content=content, created_at=now,
+    )
+    if store.insert_if_absent(export):
+        return export, True
+    # Request đồng thời khác cùng key đã thắng: trả đúng export của nó, không tạo bản thứ hai.
+    existing = store.find(principal.client_id, key)
+    if existing is None:  # pragma: no cover - chỉ xảy ra nếu DB vi phạm READ COMMITTED
+        raise RuntimeError("idempotency insert bị chặn nhưng không thấy bản ghi đã có")
+    return _replay(existing, want), False
+
+
+def _replay(existing: StoredExport, want_hash: str) -> StoredExport:
+    if existing.request_hash != want_hash:
+        raise IdempotencyConflict()
+    return existing
+
+
+def _iso(dt: datetime) -> str:
+    return dt.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")
+
+
+def _decimal(d: Decimal) -> str:
+    s = format(d, "f")
+    return s.rstrip("0").rstrip(".") if "." in s else s
+
+
+def _cell(v: str) -> str:
+    # Chống CSV/formula injection khi mở bằng bảng tính: ID hợp lệ có thể bắt đầu bằng '-'.
+    return "'" + v if v.startswith(_FORMULA_PREFIX) else v
+
+
+def render_csv(rows: list[ExportRow]) -> bytes:
+    buf = io.StringIO()
+    w = csv.writer(buf, lineterminator="\r\n")
+    w.writerow(CSV_COLUMNS)
+    for r in rows:
+        w.writerow([_cell(r.message_id), _cell(r.device_id), _cell(r.building_id), r.metric, _iso(r.event_time),
+                    _iso(r.received_at), _iso(r.interval_start) if r.interval_start else "", _decimal(r.value),
+                    r.unit, "true" if r.is_late else "false", "true" if r.is_out_of_order else "false"])
+    return buf.getvalue().encode("utf-8")
+
+
+# ------------------------------------------------------------------ PostgreSQL
+def _to_stored(e: Export) -> StoredExport:
+    return StoredExport(export_id=e.export_id, client_id=e.client_id, idempotency_key=e.idempotency_key,
+                        request_hash=e.request_hash, building_id=e.building_id, metric=e.metric, start=e.start_at,
+                        end=e.end_at, row_count=e.row_count, content_sha256=e.content_sha256,
+                        content=bytes(e.content), created_at=e.created_at)
+
+
+class PgExportStore:
+    def __init__(self, db: Session):
+        self.db = db
+
+    def find(self, client_id: str, key: str) -> StoredExport | None:
+        e = self.db.scalar(select(Export).where(Export.client_id == client_id, Export.idempotency_key == key)
+                           .execution_options(populate_existing=True))
+        return _to_stored(e) if e is not None else None
+
+    def insert_if_absent(self, export: StoredExport) -> bool:
+        stmt = (
+            pg_insert(Export)
+            .values(export_id=export.export_id, client_id=export.client_id, idempotency_key=export.idempotency_key,
+                    request_hash=export.request_hash, building_id=export.building_id, metric=export.metric,
+                    start_at=export.start, end_at=export.end, row_count=export.row_count,
+                    content_sha256=export.content_sha256, content=export.content, created_at=export.created_at)
+            .on_conflict_do_nothing(constraint="uq_exports_client_key")
+            .returning(Export.export_id)
+        )
+        return self.db.execute(stmt).first() is not None
+
+
+def pg_row_source(db: Session) -> RowSource:
+    def fetch(building_id: str, metric: str, start: datetime, end: datetime, limit: int) -> list[ExportRow]:
+        # Scope áp ngay trong SQL (JOIN devices theo building), không lọc sau ở Python.
+        # Đọc cột trực tiếp (Core), không dựng object ORM: dựng 2880 object tốn ~63 ms CPU/export (đo ở BT3, mục tải).
+        stmt = (
+            select(Reading.message_id, Reading.device_id, Device.building_id, Reading.metric, Reading.event_time,
+                   Reading.received_at, Reading.interval_start, Reading.value, Reading.is_late, Reading.is_out_of_order)
+            .join(Device, Device.device_id == Reading.device_id)
+            .where(Device.building_id == building_id, Reading.metric == metric,
+                   Reading.event_time >= start, Reading.event_time < end)
+            .order_by(Reading.event_time, Reading.message_id)
+            .limit(limit)
+        )
+        return [ExportRow(r[0], r[1], r[2], r[3], r[4], r[5], r[6], r[7], UNIT[r[3]], r[8], r[9])
+                for r in db.execute(stmt)]
+    return fetch
+
+
+def get_owned_export(db: Session, principal: Principal, export_id: uuid.UUID) -> StoredExport | None:
+    """Chỉ client tạo ra export, và building vẫn còn trong scope hiện tại, mới thấy được nó."""
+    e = db.scalar(select(Export).where(Export.export_id == export_id, Export.client_id == principal.client_id))
+    if e is None or e.building_id not in principal.buildings:
+        return None
+    return _to_stored(e)
diff --git a/src/backend/app/exports_api.py b/src/backend/app/exports_api.py
new file mode 100644
index 0000000..9e3b5c9
--- /dev/null
+++ b/src/backend/app/exports_api.py
@@ -0,0 +1,118 @@
+"""Route /api/v1/exports (BT3 VT-023). Thứ tự kiểm: xác thực -> quyền -> Idempotency-Key -> body -> scope -> tạo."""
+from __future__ import annotations
+
+import logging
+import re
+import uuid
+from collections.abc import Callable, Iterator
+from datetime import datetime, timedelta
+
+from fastapi import APIRouter, Depends, Request, Response
+from pydantic import ValidationError
+from sqlalchemy.orm import Session
+
+from .auth import authenticate, require_export
+from .config import Settings
+from .errors import export_not_found, export_too_large, idempotency_conflict, invalid_query
+from .exports import (
+    ExportRequest, ExportTooLarge, IdempotencyConflict, PgExportStore, StoredExport, create_export, get_owned_export,
+    pg_row_source,
+)
+from .params import parse_id, parse_ts, read_query
+from .schemas import ErrorResponse, ExportCreate, ExportResponse
+
+log = logging.getLogger("app.exports")
+IDEMPOTENCY_KEY_RE = re.compile(r"^[A-Za-z0-9._:-]{8,64}$")
+MAX_RANGE = timedelta(days=31)
+PREFIX = "/api/v1/exports"
+
+
+async def _raw_body(request: Request) -> bytes:
+    # Đọc body thủ công để xác thực chạy TRƯỚC khi validate body (client chưa xác thực không dò được luật validate).
+    return await request.body()
+
+
+def _parse_body(raw: bytes) -> ExportRequest:
+    try:
+        b = ExportCreate.model_validate_json(raw or b"")
+    except ValidationError:
+        raise invalid_query("body phải là JSON {building_id, metric, start, end}") from None
+    parse_id(b.building_id, "building_id")
+    start, end = parse_ts(b.start, "start"), parse_ts(b.end, "end")
+    if not start < end:
+        raise invalid_query("start must be earlier than end")
+    if end - start > MAX_RANGE:
+        raise invalid_query("khoảng thời gian export tối đa 31 ngày")
+    return ExportRequest(building_id=b.building_id, metric=b.metric, start=start, end=end)
+
+
+def _job(e: StoredExport) -> dict:
+    url = f"{PREFIX}/{e.export_id}"
+    return {"export_id": str(e.export_id), "building_id": e.building_id, "metric": e.metric, "start": e.start,
+            "end": e.end, "row_count": e.row_count, "content_sha256": e.content_sha256,
+            "created_at": e.created_at, "download_url": url}
+
+
+def build_export_router(get_db: Callable[[], Iterator[Session]], now: Callable[[], datetime], settings: Settings,
+                        err: dict) -> APIRouter:
+    router = APIRouter(prefix=PREFIX, tags=["exports"])
+    responses = {401: {"model": ErrorResponse, "description": "UNAUTHENTICATED"},
+                 403: {"model": ErrorResponse, "description": "FORBIDDEN"},
+                 404: {"model": ErrorResponse, "description": "NOT_FOUND (không tồn tại hoặc ngoài scope)"},
+                 503: err[503], 500: err[500]}
+
+    @router.post("", status_code=201, response_model=ExportResponse, responses={
+        **responses, 409: {"model": ErrorResponse, "description": "IDEMPOTENCY_CONFLICT"},
+        422: {"model": ErrorResponse, "description": "INVALID_QUERY hoặc EXPORT_TOO_LARGE"}},
+        openapi_extra={
+            "parameters": [{"name": "Idempotency-Key", "in": "header", "required": True,
+                            "schema": {"type": "string", "pattern": IDEMPOTENCY_KEY_RE.pattern}}],
+            "requestBody": {"required": True, "content": {"application/json": {
+                "schema": ExportCreate.model_json_schema()}}}})
+    def create(request: Request, response: Response, raw: bytes = Depends(_raw_body), db: Session = Depends(get_db)):
+        """Tạo export CSV readings của một building trong [start,end). Retry cùng Idempotency-Key trả lại export cũ."""
+        principal = require_export(authenticate(db, request.headers.get("authorization")))
+        key = request.headers.get("idempotency-key", "")
+        if not IDEMPOTENCY_KEY_RE.match(key):
+            raise invalid_query("thiếu hoặc sai Idempotency-Key (8-64 ký tự A-Z a-z 0-9 . _ : -)")
+        req = _parse_body(raw)
+        if req.building_id not in principal.buildings:
+            log.info("export denied client=%s reason=scope", principal.client_id)
+            raise export_not_found()
+        try:
+            export, created = create_export(PgExportStore(db), pg_row_source(db), principal, key, req,
+                                            now=now(), max_rows=settings.export_max_rows)
+        except IdempotencyConflict:
+            db.rollback()
+            raise idempotency_conflict() from None
+        except ExportTooLarge:
+            db.rollback()
+            raise export_too_large(settings.export_max_rows) from None
+        db.commit()
+        if created:
+            log.info("export created client=%s building=%s rows=%d id=%s", principal.client_id, export.building_id,
+                     export.row_count, export.export_id)
+        else:
+            response.status_code = 200
+            response.headers["Idempotent-Replayed"] = "true"
+        response.headers["Location"] = f"{PREFIX}/{export.export_id}"
+        return {"data": _job(export), "meta": {"generated_at": now()}}
+
+    @router.get("/{export_id:path}", response_class=Response, responses={
+        **responses, 200: {"content": {"text/csv": {}}, "description": "Nội dung CSV đã lưu khi tạo"}})
+    def download(export_id: str, request: Request, db: Session = Depends(get_db)):
+        """Tải CSV. Chỉ client đã tạo export và building còn trong scope; còn lại 404 như không tồn tại."""
+        read_query(request, set())  # như mọi GET khác: query param lạ -> 422 (không lộ gì về scope)
+        principal = require_export(authenticate(db, request.headers.get("authorization")))
+        try:
+            eid = uuid.UUID(export_id)
+        except ValueError:
+            raise export_not_found() from None
+        export = get_owned_export(db, principal, eid)
+        if export is None:
+            raise export_not_found()
+        return Response(export.content, media_type="text/csv; charset=utf-8", headers={
+            "Content-Disposition": f'attachment; filename="export-{export.export_id}.csv"',
+            "Cache-Control": "no-store", "ETag": f'"{export.content_sha256}"', "X-Content-Type-Options": "nosniff"})
+
+    return router
