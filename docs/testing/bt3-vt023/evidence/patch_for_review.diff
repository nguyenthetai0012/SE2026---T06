@@ -0,0 +1,92 @@
+"""Unit test cho logic export với store GIẢ (in-memory), không cần DB.
+
+Có chủ đích: các test này chỉ kiểm hợp đồng mà store giả TỰ mô phỏng. Thí nghiệm mutation trong
+docs/testing/bt3-vt023/README.md cho thấy chúng vẫn pass khi guard ở PostgreSQL bị bỏ. Đây là minh hoạ cho
+risk "mock che giấu contract sai với database"; guard thật được kiểm ở tests/integration/backend.
+"""
+from __future__ import annotations
+
+from datetime import datetime, timezone
+from decimal import Decimal
+
+import pytest
+
+from app.exports import (
+    ExportRequest, ExportRow, ExportTooLarge, IdempotencyConflict, Principal, StoredExport, create_export, render_csv,
+)
+
+T0 = datetime(2026, 10, 27, tzinfo=timezone.utc)
+T3 = datetime(2026, 10, 27, 0, 3, tzinfo=timezone.utc)
+OPS = Principal(client_id="ops", can_export=True, buildings=frozenset({"BLD-A"}))
+
+
+class FakeStore:
+    def __init__(self):
+        self.rows: dict[tuple[str, str], StoredExport] = {}
+
+    def find(self, client_id: str, key: str) -> StoredExport | None:
+        return self.rows.get((client_id, key))
+
+    def insert_if_absent(self, export: StoredExport) -> bool:
+        k = (export.client_id, export.idempotency_key)
+        if k in self.rows:
+            return False
+        self.rows[k] = export
+        return True
+
+
+def row(i: int, device: str = "A-01", value: str = "1") -> ExportRow:
+    return ExportRow(message_id=f"m-{i}", device_id=device, building_id="BLD-A", metric="power_kw",
+                     event_time=datetime(2026, 10, 27, 0, 0, i, tzinfo=timezone.utc),
+                     received_at=datetime(2026, 10, 27, 0, 0, i, tzinfo=timezone.utc), interval_start=None,
+                     value=Decimal(value), unit="kW", is_late=False, is_out_of_order=False)
+
+
+class Source:
+    def __init__(self, rows):
+        self.rows, self.calls = rows, 0
+
+    def __call__(self, building_id, metric, start, end, limit):
+        self.calls += 1
+        return self.rows[:limit]
+
+
+REQ = ExportRequest(building_id="BLD-A", metric="power_kw", start=T0, end=T3)
+
+
+def test_replay_returns_same_export_without_regenerating():
+    store, src = FakeStore(), Source([row(1), row(2)])
+    a, created_a = create_export(store, src, OPS, "key-unit-0001", REQ, now=T3, max_rows=10)
+    b, created_b = create_export(store, src, OPS, "key-unit-0001", REQ, now=T3, max_rows=10)
+    assert (created_a, created_b) == (True, False) and a == b and src.calls == 1
+
+
+def test_same_key_different_request_conflicts():
+    store = FakeStore()
+    create_export(store, Source([row(1)]), OPS, "key-unit-0002", REQ, now=T3, max_rows=10)
+    other = ExportRequest(building_id="BLD-A", metric="energy_kwh", start=T0, end=T3)
+    with pytest.raises(IdempotencyConflict):
+        create_export(store, Source([]), OPS, "key-unit-0002", other, now=T3, max_rows=10)
+
+
+def test_too_large_stores_nothing():
+    store = FakeStore()
+    with pytest.raises(ExportTooLarge):
+        create_export(store, Source([row(i) for i in range(5)]), OPS, "key-unit-0003", REQ, now=T3, max_rows=4)
+    assert store.rows == {}
+
+
+def test_request_hash_ignores_nothing_that_changes_the_result():
+    a = ExportRequest(building_id="BLD-A", metric="power_kw", start=T0, end=T3)
+    assert a.request_hash() == ExportRequest(building_id="BLD-A", metric="power_kw", start=T0, end=T3).request_hash()
+    assert a.request_hash() != ExportRequest(building_id="BLD-A", metric="power_kw", start=T0,
+                                             end=datetime(2026, 10, 27, 0, 2, tzinfo=timezone.utc)).request_hash()
+
+
+def test_render_csv_header_decimal_and_formula_guard():
+    text = render_csv([row(1, value="0.000000001"), row(2, device="-A1", value="12.500")]).decode()
+    lines = text.splitlines()
+    assert lines[0] == ("message_id,device_id,building_id,metric,event_time,received_at,interval_start,"
+                        "value,unit,is_late,is_out_of_order")
+    assert lines[1].split(",")[7] == "0.000000001"
+    assert lines[2].split(",")[1] == "'-A1" and lines[2].split(",")[7] == "12.5"
diff --git a/tools/scripts/bt3_mutation.py b/tools/scripts/bt3_mutation.py
new file mode 100644
index 0000000..b81db6f
--- /dev/null
+++ b/tools/scripts/bt3_mutation.py
@@ -0,0 +1,113 @@
+#!/usr/bin/env python3
+"""BT3 VT-023 — thí nghiệm mutation "bỏ idempotency/concurrency guard".
+
+Mỗi mutant được áp vào một git worktree TẠM (detached HEAD), chạy test rồi xoá worktree; nhánh nộp bài
+không bao giờ chứa mutant. Diff của mỗi mutant được lưu ở docs/testing/bt3-vt023/mutants/<id>.patch.
+
+    TEST_DATABASE_URL=postgresql+psycopg://USER@localhost:5432/energy_test \
+        python tools/scripts/bt3_mutation.py [--repeat 10] [--only M1,M2]
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import re
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+OUT = ROOT / "docs" / "testing" / "bt3-vt023"
+EXPORTS = "src/backend/app/exports.py"
+MODELS = "src/backend/app/models.py"
+MIGRATION = "src/backend/alembic/versions/0002_export_api.py"
+CONCURRENT = "../../tests/integration/backend/test_export_api.py::test_idempotency_concurrent_retries_create_exactly_one"
+
+MUTANTS = {
+    "M1": ("Bỏ ON CONFLICT: kiểm-rồi-chèn ở ứng dụng, vẫn giữ UNIQUE ở DB", [
+        (EXPORTS, '            .on_conflict_do_nothing(constraint="uq_exports_client_key")\n', ""),
+    ]),
+    "M2": ("Bỏ toàn bộ guard: không ON CONFLICT, không UNIQUE (migration và ORM)", [
+        (EXPORTS, '            .on_conflict_do_nothing(constraint="uq_exports_client_key")\n', ""),
+        (MIGRATION, "            CONSTRAINT uq_exports_client_key UNIQUE (client_id, idempotency_key),\n", ""),
+        (MODELS, '        UniqueConstraint("client_id", "idempotency_key", name="uq_exports_client_key"),\n', ""),
+    ]),
+    "M3": ("Bỏ UNIQUE ở migration nhưng ORM vẫn khai báo (lệch contract ORM <-> DB)", [
+        (MIGRATION, "            CONSTRAINT uq_exports_client_key UNIQUE (client_id, idempotency_key),\n", ""),
+    ]),
+    "M4": ("Replay không so sánh request_hash (cùng key, body khác vẫn trả export cũ)", [
+        (EXPORTS, "    if existing.request_hash != want_hash:\n        raise IdempotencyConflict()\n", ""),
+    ]),
+}
+
+SUMMARY = re.compile(r"(\d+) (passed|failed|error|errors)")
+
+
+def sh(cmd: list[str], cwd: Path, env=None) -> subprocess.CompletedProcess:
+    return subprocess.run(cmd, cwd=cwd, env=env, capture_output=True, text=True)
+
+
+def pytest(wt: Path, args: list[str]) -> tuple[dict, list[str], str]:
+    env = {**os.environ, "PYTHONDONTWRITEBYTECODE": "1"}
+    r = sh([sys.executable, "-m", "pytest", "-c", "pyproject.toml", "-p", "no:cacheprovider", "-q", "-rfE", *args],
+           wt / "src" / "backend", env)
+    counts = {k: int(n) for n, k in SUMMARY.findall(r.stdout.splitlines()[-1] if r.stdout else "")}
+    failed = sorted({ln.split(" ", 1)[1].split(" - ")[0] for ln in r.stdout.splitlines()
+                     if ln.startswith(("FAILED ", "ERROR ")) and "::" in ln.split(" ", 2)[1]})
+    return counts, failed, r.stdout
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--repeat", type=int, default=10, help="số lần chạy lại test đồng thời trên mỗi mutant")
+    ap.add_argument("--only", default="")
+    a = ap.parse_args()
+    if not os.environ.get("TEST_DATABASE_URL"):
+        sys.exit("Cần TEST_DATABASE_URL")
+    head = sh(["git", "rev-parse", "--short", "HEAD"], ROOT).stdout.strip()
+    (OUT / "mutants").mkdir(parents=True, exist_ok=True)
+    results = {"base_commit": head, "mutants": {}}
+    for mid, (desc, edits) in MUTANTS.items():
+        if a.only and mid not in a.only.split(","):
+            continue
+        wt = Path(tempfile.mkdtemp(prefix=f"bt3-{mid}-"))
+        sh(["git", "worktree", "add", "--detach", str(wt), "HEAD"], ROOT)
+        try:
+            for f, old, new in edits:
+                p = wt / f
+                s = p.read_text("utf-8")
+                assert s.count(old) == 1, f"{mid}: không tìm thấy đúng một chỗ cần sửa trong {f}"
+                p.write_text(s.replace(old, new), "utf-8")
+            (OUT / "mutants" / f"{mid}.patch").write_text(sh(["git", "diff"], wt).stdout, "utf-8")
+            full_counts, full_failed, _ = pytest(wt, [])
+            unit_counts, unit_failed, _ = pytest(wt, ["../../tests/unit/backend"])
+            kills, observed = 0, []
+            for _ in range(a.repeat):
+                c, _, out = pytest(wt, [CONCURRENT])
+                if c.get("failed", 0) or c.get("error", 0):
+                    kills += 1
+                    observed += [ln.strip()[:160] for ln in out.splitlines() if ln.startswith("E ") and "Counter(" in ln][:1]
+            results["mutants"][mid] = {
+                "description": desc, "full_suite": full_counts, "killed_by": full_failed,
+                "unit_tests_with_fake_store": unit_counts,
+                "concurrent_test_kill_rate": f"{kills}/{a.repeat}",
+                "concurrent_test_observed": observed[:3],
+                "status": "KILLED" if full_failed else "SURVIVED",
+            }
+            print(f"{mid}: {results['mutants'][mid]['status']} full={full_counts} unit={unit_counts} "
+                  f"concurrent={kills}/{a.repeat}")
+            for t in full_failed:
+                print("   ", t)
+            for o in observed[:2]:
+                print("    observed:", o)
+        finally:
+            sh(["git", "worktree", "remove", "--force", str(wt)], ROOT)
+    (OUT / "results").mkdir(exist_ok=True)
+    (OUT / "results" / "mutation.json").write_text(json.dumps(results, ensure_ascii=False, indent=2) + "\n", "utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
